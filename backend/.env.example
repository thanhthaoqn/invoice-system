# Gmail Invoice Integration. Copy values into deployment environment variables;
# Spring Boot does not automatically load this file.
GMAIL_INTEGRATION_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8088/oauth/gmail/callback
# Base64 of 32 random bytes. Example generation in PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_LABEL_NAME=HOA_DON
GMAIL_SYNC_INTERVAL_MS=300000
GMAIL_SYNC_PAGE_SIZE=100
GMAIL_MAX_RETRY_ATTEMPTS=3
GMAIL_FRONTEND_RESULT_URL=http://127.0.0.1:5173/?gmail=
